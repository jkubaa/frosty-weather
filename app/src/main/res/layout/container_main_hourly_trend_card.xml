<?xml version="1.0" encoding="utf-8"?>
<!--
    Frosty Weather hourly forecast (liquid glass redesign):
    a one-line summary, then a horizontal strip of  hour / icon (rain %) / temperature.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_main_hourly_trend_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- Header: title on the left, metric switcher on the right (scrolls and fades when long) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/normal_margin"
            android:minHeight="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:alpha="0.6"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_time"
                app:tint="?attr/colorSurfaceInverse" />

            <TextView
                android:id="@+id/hourly_block_title"
                style="@style/glass_card_header"
                android:layout_width="wrap_content"
                android:layout_marginStart="6dp"
                android:accessibilityHeading="true"
                android:text="@string/hourly_forecast" />

            <!-- Metric switcher: conditions, precipitation, wind... (filled in HourlyViewHolder) -->
            <org.breezyweather.ui.common.widgets.SwitcherScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:fillViewport="true"
                android:requiresFadingEdge="horizontal"
                android:fadingEdgeLength="28dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/hourly_block_switcher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:padding="2dp"
                        android:visibility="gone" />
                </FrameLayout>
            </org.breezyweather.ui.common.widgets.SwitcherScrollView>
        </LinearLayout>

        <!-- Source summary, e.g. "Rain starting around 3 PM" -->
        <TextView
            android:id="@+id/hourly_block_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/normal_margin"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textColor="?attr/colorSurfaceInverse"
            android:visibility="gone" />

        <View
            style="@style/glass_divider"
            android:layout_marginHorizontal="@dimen/normal_margin"
            android:layout_marginTop="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hourly_block_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
