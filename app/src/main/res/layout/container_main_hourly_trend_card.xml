<?xml version="1.0" encoding="utf-8"?>
<!--
    Frosty Weather hourly forecast (liquid glass redesign):
    a one-line summary, then a horizontal strip of  hour / icon (rain %) / temperature.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_main_hourly_trend_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/normal_margin"
            android:alpha="0.6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_time"
                app:tint="?attr/colorSurfaceInverse" />

            <TextView
                android:id="@+id/hourly_block_title"
                style="@style/glass_card_header"
                android:layout_marginStart="6dp"
                android:accessibilityHeading="true"
                android:alpha="1"
                android:text="@string/hourly_forecast" />
        </LinearLayout>

        <!-- Source summary, e.g. "Rain starting around 3 PM" -->
        <TextView
            android:id="@+id/hourly_block_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/normal_margin"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textColor="?attr/colorSurfaceInverse"
            android:visibility="gone" />

        <View
            style="@style/glass_divider"
            android:layout_marginHorizontal="@dimen/normal_margin"
            android:layout_marginTop="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hourly_block_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
