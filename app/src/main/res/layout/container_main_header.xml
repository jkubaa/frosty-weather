<?xml version="1.0" encoding="utf-8"?>
<!--
    Frosty Weather hero header (liquid glass redesign).
    Location name, oversized thin temperature, condition and day/night range,
    followed by a row of small glass chips (feels like, last update).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_main_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:gravity="center_horizontal"
    android:paddingStart="@dimen/normal_margin"
    android:paddingEnd="@dimen/normal_margin"
    android:paddingTop="@dimen/large_margin"
    android:paddingBottom="28dp"
    tools:ignore="UnusedAttribute">

    <!-- "⌖ Current location" caption, only for the current position -->
    <TextView
        android:id="@+id/container_main_header_location_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_location"
        android:drawablePadding="4dp"
        android:drawableTint="?attr/colorSurfaceInverse"
        android:gravity="center_vertical"
        android:text="@string/location_current"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textSize="12sp"
        android:textFontWeight="600"
        android:alpha="0.85"
        android:textColor="?attr/colorSurfaceInverse"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/container_main_header_location_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textSize="@dimen/glass_hero_location_text_size"
        android:textFontWeight="500"
        android:textColor="?attr/colorSurfaceInverse"
        android:shadowColor="#33000000"
        android:shadowRadius="12"
        tools:text="Cupertino" />

    <!-- Temperature: thin numerals with a floating degree sign -->
    <LinearLayout
        android:id="@+id/container_main_header_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Invisible spacer that balances the degree sign so the digits stay optically centred -->
        <View
            android:id="@+id/container_main_header_temperature_balance"
            android:layout_width="0dp"
            android:layout_height="1dp" />

        <org.breezyweather.ui.common.widgets.NumberAnimTextView
            android:id="@+id/container_main_header_temperature_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/glass_hero_temperature_text_size"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:letterSpacing="-0.02"
            android:textFontWeight="200"
            android:importantForAccessibility="no"
            android:textColor="?attr/colorSurfaceInverse"
            android:shadowColor="#26000000"
            android:shadowRadius="16"
            tools:text="22" />

        <TextView
            android:id="@+id/container_main_header_temperature_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="@dimen/glass_hero_temperature_text_size"
            android:textFontWeight="200"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:textColor="?attr/colorSurfaceInverse"
            android:shadowColor="#26000000"
            android:shadowRadius="16"
            android:text="°" />
    </LinearLayout>

    <TextView
        android:id="@+id/container_main_header_weather_condition_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="20sp"
        android:textFontWeight="500"
        android:textColor="?attr/colorSurfaceInverse"
        android:shadowColor="#26000000"
        android:shadowRadius="8"
        tools:text="Mostly Sunny" />

    <TextView
        android:id="@+id/container_main_header_temperature_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="18sp"
        android:textFontWeight="500"
        android:textColor="?attr/colorSurfaceInverse"
        android:shadowColor="#26000000"
        android:shadowRadius="8"
        tools:text="Day: 23° • Night: 10°" />

    <!-- Glass chips -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/container_main_header_feels_like"
            style="@style/glass_chip"
            android:layout_marginEnd="8dp"
            tools:text="Feels like 18°" />

        <org.breezyweather.ui.main.widgets.TextRelativeClock
            android:id="@+id/refreshTimeText"
            style="@style/glass_chip"
            android:drawableStart="@drawable/ic_time"
            android:drawableTint="?attr/colorSurfaceInverse"
            android:drawablePadding="6dp"
            tools:text="1 minute ago" />

    </LinearLayout>

    <!-- Debug only -->
    <TextView
        android:id="@+id/container_main_header_timezone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:alpha="0.7"
        android:textColor="?attr/colorSurfaceInverse"
        android:visibility="gone"
        tools:text="US • America/Los_Angeles" />

</LinearLayout>
