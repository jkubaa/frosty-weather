<?xml version="1.0" encoding="utf-8"?>
<!--
    Frosty Weather hero header (liquid glass redesign):
    location, condition and "feels like" on the left; a big thin temperature with today's
    high / low on the right. The name and temperature use "glassy" text (see GlassText).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_main_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:baselineAligned="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp"
    tools:ignore="UnusedAttribute">

    <!-- Left: where and what -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- "⌖ CURRENT LOCATION", only for the current position -->
        <TextView
            android:id="@+id/container_main_header_location_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_location_arrow"
            android:drawablePadding="4dp"
            android:drawableTint="?attr/colorSurfaceInverse"
            android:gravity="center_vertical"
            android:text="@string/location_current"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:textSize="12sp"
            android:textFontWeight="600"
            android:alpha="0.8"
            android:textColor="?attr/colorSurfaceInverse"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/container_main_header_location_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            android:textSize="@dimen/glass_hero_location_text_size"
            android:textFontWeight="600"
            android:textColor="?attr/colorSurfaceInverse"
            android:shadowColor="#33000000"
            android:shadowRadius="14"
            tools:text="Cupertino" />

        <TextView
            android:id="@+id/container_main_header_weather_condition_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="17sp"
            android:textFontWeight="500"
            android:textColor="?attr/colorSurfaceInverse"
            android:shadowColor="#26000000"
            android:shadowRadius="8"
            tools:text="Mostly Clear" />

        <TextView
            android:id="@+id/container_main_header_feels_like"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:alpha="0.75"
            android:textColor="?attr/colorSurfaceInverse"
            tools:text="Feels like 18°" />
    </LinearLayout>

    <!-- Right: how warm -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/container_main_header_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <org.breezyweather.ui.common.widgets.NumberAnimTextView
                android:id="@+id/container_main_header_temperature_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/glass_hero_temperature_text_size"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:letterSpacing="-0.03"
                android:textFontWeight="200"
                android:importantForAccessibility="no"
                android:textColor="?attr/colorSurfaceInverse"
                android:shadowColor="#26000000"
                android:shadowRadius="16"
                tools:text="53" />

            <TextView
                android:id="@+id/container_main_header_temperature_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/glass_hero_temperature_unit_text_size"
                android:textFontWeight="200"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:textColor="?attr/colorSurfaceInverse"
                android:shadowColor="#26000000"
                android:shadowRadius="16"
                android:text="°" />
        </LinearLayout>

        <TextView
            android:id="@+id/container_main_header_temperature_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textSize="15sp"
            android:textFontWeight="500"
            android:textColor="?attr/colorSurfaceInverse"
            android:shadowColor="#26000000"
            android:shadowRadius="8"
            tools:text="H:59°  L:46°" />
    </LinearLayout>

</LinearLayout>
