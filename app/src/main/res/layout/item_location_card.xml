<?xml version="1.0" encoding="utf-8"?>
<!--
  Location list card, iOS weather style: the location's own sky behind it, name and local time at
  the top left, condition at the bottom left, big temperature and today's high/low on the right.
  Long-press to reorder, swipe for delete / edit (the swipe colors and icons are set by the holder).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/location_card_corner_radius"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    tools:ignore="UnusedAttribute">

    <org.breezyweather.ui.common.widgets.slidingItem.SlidingItemContainerLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="112dp"
            android:orientation="horizontal"
            android:foreground="@drawable/selectable_item_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:drawablePadding="6dp"
                    android:textAlignment="viewStart"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textFontWeight="700"
                    tools:text="Paris" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart"
                    android:textColor="@android:color/white"
                    android:alpha="0.85"
                    android:textSize="14sp"
                    android:textFontWeight="500"
                    tools:text="14:32" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:minHeight="10dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/condition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart"
                    android:textColor="@android:color/white"
                    android:alpha="0.9"
                    android:textSize="14sp"
                    android:textFontWeight="500"
                    tools:text="Partly cloudy" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-6dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="52sp"
                    android:textFontWeight="300"
                    tools:text="21°" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/high_low"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:alpha="0.9"
                    android:textSize="14sp"
                    android:textFontWeight="500"
                    tools:text="H:24°  L:13°" />

            </LinearLayout>

        </LinearLayout>

    </org.breezyweather.ui.common.widgets.slidingItem.SlidingItemContainerLayout>

</com.google.android.material.card.MaterialCardView>
