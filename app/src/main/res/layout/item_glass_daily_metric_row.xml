<?xml version="1.0" encoding="utf-8"?>
<!--
    One day of the 10-day forecast for a metric other than conditions (precipitation, wind, UV...):
    divider, then  Day | arrow or dot | fill bar | value
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground">

    <View style="@style/glass_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/daily_metric_day"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="18sp"
            android:textFontWeight="500"
            android:textColor="?attr/colorSurfaceInverse"
            tools:text="Today" />

        <!-- Shown for metrics with a per-day graphic (wind arrow) -->
        <FrameLayout
            android:id="@+id/daily_metric_graphic"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/daily_metric_arrow"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_downward_alt"
                android:visibility="gone"
                app:tint="?attr/colorSurfaceInverse" />

            <View
                android:id="@+id/daily_metric_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <org.breezyweather.ui.main.widgets.FillBarView
            android:id="@+id/daily_metric_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp" />

        <TextView
            android:id="@+id/daily_metric_value"
            android:layout_width="@dimen/glass_daily_metric_value_width"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:textSize="17sp"
            android:textFontWeight="500"
            android:textColor="?attr/colorSurfaceInverse"
            tools:text="40%" />
    </LinearLayout>

</LinearLayout>
