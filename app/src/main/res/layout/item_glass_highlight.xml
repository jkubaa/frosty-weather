<?xml version="1.0" encoding="utf-8"?>
<!--
    One highlight as a round gauge (watch-complication style): a ring with a value or icon inside,
    then a short label and sub-label, e.g. "97%" / "Rain" / "Fri", or a sunset icon / "Sunset" / "5:01 PM".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="10dp"
    android:focusable="true"
    android:screenReaderFocusable="true">

    <FrameLayout
        android:layout_width="@dimen/glass_highlight_gauge_size"
        android:layout_height="@dimen/glass_highlight_gauge_size">

        <org.breezyweather.ui.main.widgets.RingGaugeView
            android:id="@+id/highlight_gauge"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/highlight_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textSize="17sp"
            android:textFontWeight="600"
            android:textColor="?attr/colorSurfaceInverse"
            tools:text="97%" />

        <ImageView
            android:id="@+id/highlight_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:tint="?attr/colorSurfaceInverse"
            tools:src="@drawable/ic_twilight" />
    </FrameLayout>

    <TextView
        android:id="@+id/highlight_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textFontWeight="600"
        android:textColor="?attr/colorSurfaceInverse"
        tools:text="Rain" />

    <TextView
        android:id="@+id/highlight_sublabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:alpha="0.7"
        android:textColor="?attr/colorSurfaceInverse"
        tools:text="Fri" />

</LinearLayout>
