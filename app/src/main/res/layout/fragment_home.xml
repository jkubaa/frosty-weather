<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:liftOnScrollColor="@android:color/transparent">

            <!-- Compact title fading in on scroll (see HomeTopBarView) -->
            <org.breezyweather.ui.main.fragments.HomeTopBarView
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <org.breezyweather.ui.common.widgets.SwipeSwitchLayout
                android:id="@+id/switch_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false">

                    <!-- The cards, in Compose, with their own pull-to-refresh (see HomeCardsView) -->
                    <org.breezyweather.ui.main.fragments.HomeCardsView
                        android:id="@+id/cards_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/action_pull_down_to_refresh"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textAlignment="center"
                    android:paddingHorizontal="@dimen/normal_margin"
                    android:visibility="gone" />

            </org.breezyweather.ui.common.widgets.SwipeSwitchLayout>

            <!--
                Floating liquid glass bottom bar, iOS weather style:
                edit location (start), location page dots (center), location list (end).
            -->
            <FrameLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/glass_bottom_bar_margin_horizontal"
                android:layout_height="@dimen/glass_capsule_height"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/glass_capsule_margin_bottom"
                app:layout_behavior="org.breezyweather.ui.common.behaviors.FloatingAboveSnackbarBehavior">

                <!-- Glass buttons and page dots, in Compose (see HomeBottomBarView) -->
                <org.breezyweather.ui.main.fragments.HomeBottomBarView
                    android:id="@+id/bottomBarContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </FrameLayout>


        </androidx.coordinatorlayout.widget.CoordinatorLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
