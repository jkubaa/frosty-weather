<?xml version="1.0" encoding="utf-8"?>
<!--
    Liquid glass notification card: the glass body (frosted backdrop, tint and sheen) is applied to
    @id/snackbar_card at runtime by LiquidGlass.applyFloating(), like the home bottom bar.
    Aligned with the bottom bar's side margins, a single line reads as a capsule.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/snackbar_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/small_margin"
    android:layout_marginHorizontal="@dimen/glass_bottom_bar_margin_horizontal"
    android:minHeight="@dimen/glass_capsule_height">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:minHeight="@dimen/glass_capsule_height"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/snackbar_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:textColor="?attr/colorSurfaceInverse"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:maxLines="@integer/design_snackbar_text_max_lines"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            tools:text="Text Goes Here" />

        <Button
            android:id="@+id/snackbar_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:textAllCaps="false"
            style="?attr/borderlessButtonStyle"
            tools:visibility="visible"
            tools:text="Action" />

    </LinearLayout>

</FrameLayout>
