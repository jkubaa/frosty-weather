<?xml version="1.0" encoding="utf-8"?>
<!-- One day of the 10-day forecast: divider, then  Day | icon (rain %) | low | range bar | high -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground">

    <View
        style="@style/glass_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/daily_row_day"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="18sp"
            android:textFontWeight="500"
            android:textColor="?attr/colorSurfaceInverse"
            tools:text="Today" />

        <!-- Icon with the chance of precipitation under it -->
        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/daily_row_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/daily_row_precipitation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textSize="11sp"
                android:textFontWeight="600"
                android:textColor="@color/glass_precipitation"
                android:visibility="gone"
                tools:text="40%"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/daily_row_low"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:textSize="18sp"
            android:textFontWeight="500"
            android:textColor="?attr/colorSurfaceInverse"
            android:alpha="0.6"
            tools:text="12°" />

        <org.breezyweather.ui.main.widgets.TemperatureRangeBarView
            android:id="@+id/daily_row_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/daily_row_high"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:textSize="18sp"
            android:textFontWeight="500"
            android:textColor="?attr/colorSurfaceInverse"
            tools:text="21°" />
    </LinearLayout>

</LinearLayout>
