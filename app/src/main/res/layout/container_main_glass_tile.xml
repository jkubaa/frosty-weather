<?xml version="1.0" encoding="utf-8"?>
<!--
    Square liquid glass tile, iOS weather style:
    small uppercase header, big left-aligned value, a short label, then an optional graphic
    (scale bar, compass...) and description at the bottom. Filled by GlassTileViewHolder subclasses.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/tile_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tile_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    app:tint="?attr/colorSurfaceInverse"
                    tools:src="@drawable/ic_uv" />

                <TextView
                    android:id="@+id/tile_title"
                    style="@style/glass_card_header"
                    android:layout_marginStart="5dp"
                    android:accessibilityHeading="true"
                    android:alpha="1"
                    android:textSize="12sp"
                    tools:text="UV index" />
            </LinearLayout>

            <!-- Value and label, with an optional side graphic (e.g. the wind compass) to their right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tile_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:textSize="32sp"
                        android:textFontWeight="400"
                        android:textColor="?attr/colorSurfaceInverse"
                        tools:text="4" />

                    <TextView
                        android:id="@+id/tile_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textSize="17sp"
                        android:textFontWeight="600"
                        android:textColor="?attr/colorSurfaceInverse"
                        android:visibility="gone"
                        tools:text="Moderate"
                        tools:visibility="visible" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/tile_side"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Graphic: fills the remaining space, content aligned to its bottom -->
            <FrameLayout
                android:id="@+id/tile_graphic"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tile_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:textSize="13sp"
                android:alpha="0.85"
                android:textColor="?attr/colorSurfaceInverse"
                android:visibility="gone"
                tools:text="The dew point is 5° right now."
                tools:visibility="visible" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
