<?xml version="1.0" encoding="utf-8"?>
<!-- One day of the large widget: name, icon, low, temperature range bar, high -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_day_name"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/daily_today_short"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/widget_day_icon"
        android:layout_width="34dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/frosted_weather_30" />

    <TextView
        android:id="@+id/widget_day_low"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:maxLines="1"
        android:text="13°"
        android:textColor="#99FFFFFF"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/widget_day_bar"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_frosty_bar_preview" />

    <TextView
        android:id="@+id/widget_day_high"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:maxLines="1"
        android:text="24°"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

</LinearLayout>
